rules_version = '2';

// Each signed-in person can read and write only their own data under users/<their uid>/.
// Nobody can read anyone else's. Paste this into Firebase console > Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
